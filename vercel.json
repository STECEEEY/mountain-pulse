{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "git": {
    "deploymentEnabled": {
      "main": false,
      "master": true
    }
  },
  "rewrites": [
    {
      "source": "/api/auth/(.*)",
      "destination": "http://47.102.147.118:3000/api/auth/$1"
    },
    {
      "source": "/api/tencent",
      "destination": "/api/tencent.ts"
    },
    {
      "source": "/api/deformation/(.*)",
      "destination": "http://47.102.147.118:8000/api/deformation/$1"
    },
    {
      "source": "/api/rainfall/(.*)",
      "destination": "http://47.102.147.118:5000/api/rainfall/$1"
    },
    {
      "source": "/api/risk/predict",
      "destination": "http://47.102.147.118:8001/predict"
    },
    {
      "source": "/geodata/:path*",
      "destination": "http://47.102.147.118:8080/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
